# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave empty for SQLite (Phases 0-1). From Phase 2:
# DATABASE_URL=postgres://nextrade:nextrade@localhost:5432/nextrade

# Exchange used by research and trading: quidax (Binance is blocked on many Nigerian networks)
NEXTRADE_VENUE=quidax
# Quidax secret key (Settings > API). Leave empty until live trading (Phase 14).
QUIDAX_SECRET_KEY=
QUIDAX_SYMBOLS=ETHNGN,USDTNGN,BTCNGN,SOLNGN,BTCUSDT,ETHUSDT

# Binance MAINNET key: enable "Reading" and "Spot Trading" ONLY. Withdrawals must be OFF.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance SPOT TESTNET key (fake money), from https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Display only: your current naira rate per USDT
NGN_PER_USDT=1500
NEXTRADE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,LINKUSDT,AVAXUSDT
LOG_LEVEL=INFO
